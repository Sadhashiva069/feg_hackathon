# The prototype needs no secrets. Every setting below has a working default; copy to .env only if you want to change one.
# (The edge reads PORT from the environment; the rest are documented here for the reviewer and used by the scripts.)

# Accelerated edge / origin (lobby + service worker + versioned immutable bundle)
PORT=8080

# Baseline origin for the side-by-side demo (same bundle, served as shipped today: no edge compression, no caching, no worker)
BASELINE_PORT=8081

# Where the edge writes its JSONL access log and the lobby's measurement beacons (git-ignored)
EDGE_LOG=var/edge-access.jsonl

# Optional: public URL of a tunnel in front of the edge for real-device runs (cloudflared quick tunnel prints it)
# PUBLIC_URL=https://<name>.trycloudflare.com
# BASELINE_PUBLIC_URL=https://<name2>.trycloudflare.com

# Optional: Android SDK platform-tools for real-phone runs (scripts/loadtime-harness/run-android.js)
# ADB=C:\Users\<you>\AppData\Local\Android\Sdk\platform-tools\adb.exe
